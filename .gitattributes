* text=auto

# Text: normalise to LF so scripts and manifests are identical on any machine
*.py      text eol=lf
*.md      text eol=lf
*.csv     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.txt     text eol=lf
*.ps1     text eol=crlf

# Binary: never diff, never convert
*.jpg     binary
*.jpeg    binary
*.png     binary
*.pdf     binary
*.pt      binary
*.pth     binary
*.npz     binary
*.onnx    binary

# Frozen manifest: the pre-registered SHA-256 (1D726C51...D75C) is defined over
# the CRLF working file, so force CRLF on checkout on every platform. Git still
# stores the canonical LF blob; the file's content is never rewritten.
dataset/splits.csv text eol=crlf
